# ── 커넥트 백엔드 설정 예시 ──
# 이 파일을 복사해서 ".env" 로 저장하고 값을 채웁니다. ".env" 는 git 에 올라가지 않습니다.

PORT=4000

# 이 주소들에서 오는 요청만 허용합니다(쉼표로 여러 개). 배포 주소가 생기면 추가하세요.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# 관리자 계정
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=여기에-긴-비밀번호

# 광고주 계정: 이메일|비밀번호|브랜드(광고주)명 ; 이메일|비밀번호|브랜드명
# 브랜드명이 캠페인의 "광고주"와 같은 캠페인만 해당 광고주에게 보입니다.
ADVERTISERS=brand@example.com|여기에-비밀번호|월트디즈니 코리아

# 토큰 서명용 비밀값(길수록 좋음). 비워 두면 data/secret.key 에 자동 생성합니다.
TOKEN_SECRET=

# YouTube Data API v3 키 — 이 파일에만 넣고, 대화창·코드·깃에는 올리지 마세요.
YOUTUBE_API_KEY=

# 짤(ZEAL) 어드민 직접 조회 — 리포트 "자동 조회"가 채널 ID(CID)로 짤 회원 정보를 가져올 때 쓴다.
# 비워 두면 저장된 회원 목록(data-zeal.json 을 가져온 것)으로만 조회한다.
# ZEAL_ADMIN_COOKIE 는 어드민에 로그인한 브라우저의 쿠키 값(로그인이 만료되면 새로 복사). 대화창·코드·깃에 올리지 마세요.
ZEAL_ADMIN_BASE=
ZEAL_ADMIN_COOKIE=

# 영화진흥위원회(KOBIS) 오픈API 키 — 영업 캘린더(개봉 일정·영화 검색)용. 서버가 대신 호출하므로 화면 코드에는 두지 않는다.
KOBIS_API_KEY=

# 서버 신원 증명용 개인키 — "node gen-identity.js" 가 만들어 .env 에 넣어 준다. 비워 두면 ?api= 로 공유 연결을 할 수 없다.
# (이 값은 공개하지 마세요. 사이트에는 짝이 되는 공개키만 들어 있다)
IDENTITY_PRIVATE_KEY=
